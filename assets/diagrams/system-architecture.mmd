flowchart TB

    subgraph DAILY["Daily Production Pipeline"]
        A["Daily Schedule Trigger"]
        B["Discovery Layer<br/>8 source-specific workflows<br/>Independent failure boundaries<br/><br/>APIs · Feeds · Structured Web Data · Email"]
        C["Merge / Synchronization"]
        D["Deterministic Hard Filter"]
        E["Semantic AI Evaluation<br/>Structured LLM Output"]
        F["Deterministic Decision Engine<br/>APPLY · REVIEW · SKIP"]
        R["Fallback → REVIEW<br/>AI / structured-output failure"]
        G["Telegram Daily Digest<br/>Prioritized Delivery"]

        A --> B
        B --> C
        C --> D
        D --> E

        E -->|valid structured output| F
