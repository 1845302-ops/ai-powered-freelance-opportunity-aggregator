    F -. "evaluation + provenance + decision" .-> DB
    R -. "fallback REVIEW + error metadata" .-> DB
    G -. "delivery log" .-> DB

    subgraph OPS["Independent Weekly Operations"]
        H["DB Housekeeping<br/>180-day retention<br/>Count → Guard → Delete"]
        I["SKIP Audit<br/>Borderline + random sample<br/>False-negative quality control"]
        J["Telegram Weekly Audit Digest"]

        I --> J
    end

    H -. "retention check & cleanup" .-> DB
    DB -. "sample stored SKIP decisions" .-> I